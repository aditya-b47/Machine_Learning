   "source": [
    "def temp(I1,T1,I2,T2,I):\n",
    "  increase_in_T_per_change_in_I = (T2-T1)/(I2-I1)\n",
    "  increase_in_Temp = (I-I1) * increase_in_T_per_change_in_I\n",
    "  return T1 + increase_in_Temp"
   ]
  },
