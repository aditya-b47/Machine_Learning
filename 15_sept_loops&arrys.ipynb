   "source": [
    "Write find_min_max(numbers) that returns (minimum, maximum).\n",
    "\n",
    "\n",
    "find_min_max([5, 8, 2, 10, 3])  # (2, 10)\n",
    "find_min_max([7, 7, 7, 7])       # (7, 7)\n",
    "find_min_max([-3, 0, 3])         # (-3, 3)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "629d5221",
   "metadata": {},
   "outputs": [],
   "source": [
    "def min(num):\n",
    "  curernt_min = num[0]\n",
    "  for i in num:\n",
    "    if i < curernt_min:\n",
    "      curernt_min = num\n",
    "    return min"
   ]
